# Normalize line endings: LF in the repository, native on checkout.
* text=auto eol=lf

*.java text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
*.sh text eol=lf

*.png binary
*.ico binary
*.pdf binary
*.zip binary
